    {
      "name": "Analyze actual SMS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/analyze/sms",
        "description": "Use real authenticated, redacted submissions. Empty variables must be configured; no dummy records or predictions are supplied. A pre-request script JSON-serializes the actual collection variables, preserving quotes/newlines safely.",
        "body": {
          "mode": "raw",
          "raw": "{{request_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const submission = {",
              "  \"content\": pm.collectionVariables.get(\"sms_content\"),",
              "  \"source\": \"android_share\",",
              "  \"device_id\": null,",
              "  \"use_threat_intelligence\": false",
              "};",
              "pm.variables.set('request_body', JSON.stringify(submission));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const result = pm.response.json();",
              "  pm.test('Actual investigation ID returned', () => pm.expect(result.investigation_id).to.be.a('string'));",
              "  pm.test('Risk score remains unavailable', () => pm.expect(result.assessment.risk_score).to.eql(null));",
              "  pm.collectionVariables.set('investigation_id', result.investigation_id);",
              "}"
            ]
          }
        }
      ]
