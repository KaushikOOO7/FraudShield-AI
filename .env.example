# Copy to .env and set actual deployment values. Never commit .env.
APP_ENV=development
# Local SQLite is explicit development storage. PostgreSQL setup is documented.
DATABASE_URL=sqlite:///./data/fraudshield.sqlite3
SUPABASE_URL=
# Optional ONLY for an existing legacy HS256 Supabase project; never issues tokens.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
# Optional trusted model directory. Default: backend/app/ml/models.
# SMS_MODEL_DIR=/absolute/path/to/trained/models
# Optional trusted URL artifact directory; the model is not trained here.
# URL_MODEL_DIR=/absolute/path/to/trained/models
# URL_MODEL_DIR=/absolute/path/to/trained/models

GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
PHISHTANK_API_KEY=
ABUSEIPDB_API_KEY=
ENABLE_RDAP=false
ENABLE_CRTSH=false
GEMINI_API_KEY=
# Set an actual supported model ID for your Gemini account; no default is guessed.
# GEMINI_MODEL=your-supported-model-id

ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
MAX_REQUEST_BYTES=32768
REQUEST_BODY_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=30
IP_RATE_LIMIT_PER_MINUTE=120
PROVIDER_TIMEOUT_SECONDS=5
JWKS_CACHE_SECONDS=300
INVESTIGATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
COMMUNITY_REPORT_RETENTION_DAYS=30
QR_MAX_UPLOAD_BYTES=2097152
APK_MAX_UPLOAD_BYTES=20971520
